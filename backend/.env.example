# Required for the remote (Gemini) route and for prompt optimization
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ollama | gemini | auto  (auto = let the router decide, fall back to Gemini if Ollama is down)
MODEL_PROVIDER=auto
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=gemma3:4b

# Prompt compression (no API tokens unless COMPRESSOR=llm):
#   auto  = rule-based filler removal, then LLMLingua-2 if installed (requirements-lingua.txt)
#   rules = rule-based filler removal only
#   llm   = one LLM rewrite call (costs API tokens)
COMPRESSOR=auto
# Fraction of tokens LLMLingua-2 keeps
COMPRESSION_RATE=0.6

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional: if set, clients must send this value in the X-API-Key header
API_KEY=

# Abuse protection
MAX_PROMPT_CHARS=8000
RATE_LIMIT_PER_MINUTE=20
LLM_TIMEOUT_SECONDS=60
METRICS_DB_PATH=metrics.db
